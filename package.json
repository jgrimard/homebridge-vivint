{
  "name": "@jgrimard/homebridge-vivint",
  "displayName": "Homebridge Vivint",
  "type": "module",
  "version": "2.0.2-beta.0",
  "description": "Homebridge plugin for Vivint Smart Home security systems and devices.",
  "license": "Apache-2.0",
  "author": "Jason Grimard",
  "contributors": [
    "Alexandr Balan <balansse@gmail.com>",
    "Tim Harper <timcharper@gmail.com>"
  ],
  "homepage": "https://github.com/jgrimard/homebridge-vivint#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jgrimard/homebridge-vivint.git"
  },
  "bugs": {
    "url": "https://github.com/jgrimard/homebridge-vivint/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "vivint",
    "security",
    "camera",
    "homekit"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc && tsc -p tsconfig.ui.json && node scripts/copy-assets.js",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test \"test/*.test.js\"",
    "mfa": "node scripts/vivint-mfa-cli.js",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.5",
    "ffmpeg-for-homebridge": "^2.2.2",
    "pubnub": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "homebridge": "^2.1.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  }
}
